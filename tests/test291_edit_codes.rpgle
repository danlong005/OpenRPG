**FREE
// Every %EDITC edit code on a positive, a negative and a zero value, plus
// how DSPLY and %CHAR show numeric, float and date fields -- the formats
// IBM i uses, checked by scripts/ibmi-execution.sh against a real IBM i.
// Each result keeps the field's full edited width; the brackets show it.
// The edit code must be a literal or named constant (IBM: RNF0355).
DCL-S pos PACKED(7:2) INZ(1234.5);
DCL-S neg PACKED(7:2) INZ(-1234.5);
DCL-S nil PACKED(7:2) INZ(0);
DCL-S small PACKED(5:2) INZ(-0.05);
DCL-S whole INT(5) INZ(-42);
DCL-S ymd ZONED(6:0) INZ(260926);
DCL-S f4 FLOAT(4) INZ(1.5);
DCL-S f8 FLOAT(8) INZ(-0.001);
DCL-S day DATE INZ(D'2026-09-26');
DCL-S line VARCHAR(52);

line = '1[' + %EDITC(pos : '1') + '][' + %EDITC(neg : '1') + ']';
DSPLY line;
line = '1[' + %EDITC(nil : '1') + '][' + %EDITC(small : '1') + ']';
DSPLY line;
line = '2[' + %EDITC(pos : '2') + '][' + %EDITC(neg : '2') + ']';
DSPLY line;
line = '2[' + %EDITC(nil : '2') + '][' + %EDITC(small : '2') + ']';
DSPLY line;
line = '3[' + %EDITC(pos : '3') + '][' + %EDITC(neg : '3') + ']';
DSPLY line;
line = '3[' + %EDITC(nil : '3') + '][' + %EDITC(small : '3') + ']';
DSPLY line;
line = '4[' + %EDITC(pos : '4') + '][' + %EDITC(neg : '4') + ']';
DSPLY line;
line = '4[' + %EDITC(nil : '4') + '][' + %EDITC(small : '4') + ']';
DSPLY line;
line = 'A[' + %EDITC(pos : 'A') + '][' + %EDITC(neg : 'A') + ']';
DSPLY line;
line = 'A[' + %EDITC(nil : 'A') + '][' + %EDITC(small : 'A') + ']';
DSPLY line;
line = 'B[' + %EDITC(pos : 'B') + '][' + %EDITC(neg : 'B') + ']';
DSPLY line;
line = 'B[' + %EDITC(nil : 'B') + '][' + %EDITC(small : 'B') + ']';
DSPLY line;
line = 'C[' + %EDITC(pos : 'C') + '][' + %EDITC(neg : 'C') + ']';
DSPLY line;
line = 'C[' + %EDITC(nil : 'C') + '][' + %EDITC(small : 'C') + ']';
DSPLY line;
line = 'D[' + %EDITC(pos : 'D') + '][' + %EDITC(neg : 'D') + ']';
DSPLY line;
line = 'D[' + %EDITC(nil : 'D') + '][' + %EDITC(small : 'D') + ']';
DSPLY line;
line = 'J[' + %EDITC(pos : 'J') + '][' + %EDITC(neg : 'J') + ']';
DSPLY line;
line = 'J[' + %EDITC(nil : 'J') + '][' + %EDITC(small : 'J') + ']';
DSPLY line;
line = 'K[' + %EDITC(pos : 'K') + '][' + %EDITC(neg : 'K') + ']';
DSPLY line;
line = 'K[' + %EDITC(nil : 'K') + '][' + %EDITC(small : 'K') + ']';
DSPLY line;
line = 'L[' + %EDITC(pos : 'L') + '][' + %EDITC(neg : 'L') + ']';
DSPLY line;
line = 'L[' + %EDITC(nil : 'L') + '][' + %EDITC(small : 'L') + ']';
DSPLY line;
line = 'M[' + %EDITC(pos : 'M') + '][' + %EDITC(neg : 'M') + ']';
DSPLY line;
line = 'M[' + %EDITC(nil : 'M') + '][' + %EDITC(small : 'M') + ']';
DSPLY line;
line = 'N[' + %EDITC(pos : 'N') + '][' + %EDITC(neg : 'N') + ']';
DSPLY line;
line = 'N[' + %EDITC(nil : 'N') + '][' + %EDITC(small : 'N') + ']';
DSPLY line;
line = 'O[' + %EDITC(pos : 'O') + '][' + %EDITC(neg : 'O') + ']';
DSPLY line;
line = 'O[' + %EDITC(nil : 'O') + '][' + %EDITC(small : 'O') + ']';
DSPLY line;
line = 'P[' + %EDITC(pos : 'P') + '][' + %EDITC(neg : 'P') + ']';
DSPLY line;
line = 'P[' + %EDITC(nil : 'P') + '][' + %EDITC(small : 'P') + ']';
DSPLY line;
line = 'Q[' + %EDITC(pos : 'Q') + '][' + %EDITC(neg : 'Q') + ']';
DSPLY line;
line = 'Q[' + %EDITC(nil : 'Q') + '][' + %EDITC(small : 'Q') + ']';
DSPLY line;
line = 'Z[' + %EDITC(pos : 'Z') + '][' + %EDITC(neg : 'Z') + ']';
DSPLY line;
line = 'Z[' + %EDITC(nil : 'Z') + '][' + %EDITC(small : 'Z') + ']';
DSPLY line;
line = 'X[' + %EDITC(pos : 'X') + '] Y[' + %EDITC(ymd : 'Y') + ']';
DSPLY line;
line = 'INT[' + %EDITC(whole : '1') + '][' + %EDITC(whole : 'J') + ']';
DSPLY line;
line = 'CHAR ' + %CHAR(small) + ' ' + %CHAR(nil) + ' ' + %CHAR(f4);
DSPLY line;
line = 'FLT ' + %CHAR(f8);
DSPLY line;
DSPLY neg;
DSPLY nil;
DSPLY whole;
DSPLY f8;
DSPLY day;
*INLR = *ON;
